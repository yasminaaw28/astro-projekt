---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="contact-page">
    <section class="contact-top">
      <div class="contact-left">
        <h1>CONTACT<br />US</h1>

        <p class="intro">Want to get in touch?</p>

        <p>
          For <strong>group tickets & business inquiries</strong> please email
          <a href="mailto:impact@trifo.dk">impact@trifo.dk</a>
        </p>

        <p>
          For <strong>partnerships</strong> please email Anne Katrine Heje Larsen, Head of Impact and Partnerships, at
          <a href="mailto:akh@trifo.dk">akh@trifo.dk</a>
        </p>

        <p>For general questions, please fill out the form below.</p>

        <form class="contact-form">
          <label>Name</label>

          <div class="name-row">
            <div>
              <label for="first-name">First Name <span>(required)</span></label>
              <input id="first-name" type="text" required />
            </div>

            <div>
              <label for="last-name">Last Name <span>(required)</span></label>
              <input id="last-name" type="text" required />
            </div>
          </div>

          <label for="email">Email <span>(required)</span></label>
          <input id="email" type="email" required />

          <label for="message">Message <span>(required)</span></label>
          <textarea id="message" required></textarea>

          <button type="submit">SEND</button>
        </form>
      </div>

      <div class="contact-image">
        <img src="/contact-billede.jpg" alt="People at Impact Festival" />
      </div>
    </section>

    <section class="contact-bottom">
      <div class="bottom-left">
        <div class="socials">
          <a href="#"><img src="/instagram-logo.png" alt="Instagram" /></a>
          <a href="#">in</a>
          <a href="#">f</a>
        </div>

        <img src="/impact-logo.png" alt="Impact Festival" class="impact-logo" />
      </div>

      <div class="bottom-right">
        <div class="details">
          <div>
            <h2>Location</h2>
            <p>Bådehavnsgade 42 2450, København SV</p>
          </div>

          <div>
            <h2>Contact</h2>
            <p>
              <a href="mailto:impact@trifo.dk">impact@trifo.dk</a>
            </p>
          </div>
        </div>

        <p class="company-info">
          IMPACT FESTIVAL is organized by Forening Impact,<br />
          Sydhavnen, CVR no. 46334272, Bådehavnsgade 42, 2450 <br />
          Copenhagen SV. Tickets are sold through
          <a href="#">billetsalg.dk</a>
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    font-family: Arial, Helvetica, sans-serif;
    color: #000;
    background: #fff;
  }

  .contact-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 55px 65px 90px;
    box-sizing: border-box;
  }

  .contact-left h1 {
    margin: 0 0 30px;
    font-size: 82px;
    line-height: 0.8;
    font-weight: 900;
  }

  .contact-left p {
    max-width: 650px;
    font-size: 18px;
    line-height: 1.5;
  }

  .contact-left a {
    color: #000;
    text-decoration: underline;
  }

  .intro {
    margin-bottom: 30px;
  }

  .contact-form {
    max-width: 650px;
    margin-top: 70px;
  }

  .contact-form label {
    display: block;
    margin-bottom: 7px;
    font-size: 16px;
  }

  .contact-form label span {
    color: #555;
  }

  .name-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 22px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1.5px solid #000;
    padding: 14px 18px;
    font-size: 16px;
    background: #fff;
  }

  .contact-form input {
    height: 48px;
    border-radius: 30px;
  }

  .contact-form > input {
    margin-bottom: 22px;
  }

  .contact-form textarea {
    min-height: 160px;
    margin-bottom: 20px;
    border-radius: 22px;
    resize: vertical;
  }

  .contact-form button {
    padding: 14px 35px;
    border: 0;
    border-radius: 30px;
    background: #ed0b15;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
  }
  .contact-image img {
    display: block;
    width: 100%;
    height: 900px;
    object-fit: cover;
    object-position: center;
  }

  .contact-bottom {
    display: grid;
    grid-template-columns: 58% 42%;
    max-width: 1600px;
    min-height: 620px;
    margin: 0 auto;
    padding: 10px 50px 100px;
    box-sizing: border-box;
  }

  .bottom-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-right: 80px;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .socials a {
    color: #000;
    text-decoration: none;
    font-size: 28px;
    font-weight: 700;
  }

  .socials img {
    width: 50px;
    height: 50px;
    display: block;
    object-fit: contain;
  }

  .impact-logo {
    width: 700px;
    max-width: 100%;
    height: auto;
  }

  .bottom-right {
    padding-left: 30px;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }

  .details h2 {
    margin: 0 0 45px;
    font-size: 42px;
    line-height: 1;
    font-weight: 900;
  }

  .details p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }

  .details a,
  .company-info a {
    color: #000;
    text-decoration: underline;
  }

  .company-info {
    max-width: 560px;
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .contact-top {
      grid-template-columns: 1fr;
      padding: 30px 20px 60px;
    }

    .contact-left h1 {
      font-size: 58px;
    }

    .name-row {
      grid-template-columns: 1fr;
    }

    .contact-bottom {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 50px 20px 70px;
      gap: 70px;
    }

    .bottom-left {
      padding-right: 0;
      gap: 70px;
    }

    .bottom-right {
      padding-left: 0;
    }

    .impact-logo {
      width: 100%;
    }

    .details {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .details h2 {
      font-size: 36px;
      margin-bottom: 25px;
    }

    .details p {
      font-size: 18px;
    }

    .company-info {
      max-width: 100%;
      margin-top: 50px;
      font-size: 18px;
    }
  }
</style>
