---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="contact-page">
    <section class="contact-top">
      <div class="contact-left">
        <h1>CONTACT<br />US</h1>

        <p class="intro">Want to get in touch?</p>

        <p>
          For <strong>group tickets & business inquiries</strong> please email
          <a href="mailto:impact@trifo.dk"> impact@trifo.dk</a>
        </p>

        <p>
          For <strong>partnerships</strong> please email Anne Katrine Heje Larsen, Head of Impact and Partnerships, at
          <a href="mailto:akh@trifo.dk"> akh@trifo.dk</a>
        </p>

        <p>For general questions, please fill out the form below.</p>

        <form class="contact-form">
          <label>Name</label>

          <div class="name-row">
            <div>
              <label for="first-name">
                First Name <span>(required)</span>
              </label>
              <input id="first-name" type="text" required />
            </div>

            <div>
              <label for="last-name">
                Last Name <span>(required)</span>
              </label>
              <input id="last-name" type="text" required />
            </div>
          </div>

          <label for="email">
            Email <span>(required)</span>
          </label>
          <input id="email" type="email" required />

          <label for="message">
            Message <span>(required)</span>
          </label>
          <textarea id="message" required></textarea>

          <button type="submit">SEND</button>
        </form>
      </div>

      <div class="contact-image">
        <img src="/contact-billede.jpg" alt="People at Impact Festival" />
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    font-family: Arial, Helvetica, sans-serif;
    color: #000;
    background: #fff;
  }

  .contact-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 55px 65px 90px;
    box-sizing: border-box;
  }

  .contact-left h1 {
    margin: 0 0 30px;
    font-size: 82px;
    line-height: 0.8;
    font-weight: 900;
  }

  .contact-left p {
    max-width: 650px;
    font-size: 18px;
    line-height: 1.5;
  }

  .contact-left a {
    color: #000;
    text-decoration: underline;
  }

  .intro {
    margin-bottom: 30px;
  }

  .contact-form {
    max-width: 650px;
    margin-top: 70px;
  }

  .contact-form label {
    display: block;
    margin-bottom: 7px;
    font-size: 16px;
  }

  .contact-form label span {
    color: #555;
  }

  .name-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 22px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1.5px solid #000;
    padding: 14px 18px;
    font-size: 16px;
    background: #fff;
  }

  .contact-form input {
    height: 48px;
    border-radius: 30px;
  }

  .contact-form > input {
    margin-bottom: 22px;
  }

  .contact-form textarea {
    min-height: 160px;
    margin-bottom: 20px;
    border-radius: 22px;
    resize: vertical;
  }

  .contact-form button {
    padding: 14px 35px;
    border: 0;
    border-radius: 30px;
    background: #ed0b15;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
  }

  .contact-image img {
    display: block;
    width: 100%;
    height: 900px;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 900px) {
    .contact-top {
      grid-template-columns: 1fr;
      padding: 30px 20px 60px;
    }

    .contact-left h1 {
      font-size: 58px;
    }

    .name-row {
      grid-template-columns: 1fr;
    }

    .contact-image img {
      height: auto;
    }
  }
</style>
