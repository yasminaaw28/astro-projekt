---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />

  <main class="contact-page">
    <section class="contact-left">
      <h1>CONTACT<br />US</h1>

      <p class="intro">Want to get in touch?</p>

      <p>
        For <strong>group tickets & business inquiries</strong> please email
        <a href="mailto:impact@trifo.dk">impact@trifo.dk</a>
      </p>

      <p>
        For <strong>partnerships</strong> please email Anne Katrine Heje Larsen, Head of Impact and Partnerships, at
        <a href="mailto:akh@trifo.dk">akh@trifo.dk</a>
      </p>

      <p>For general questions, please fill out the form below.</p>

      <form class="contact-form">
        <label>Name</label>

        <div class="name-row">
          <div>
            <label for="first-name">First Name <span>(required)</span></label>
            <input id="first-name" type="text" required />
          </div>

          <div>
            <label for="last-name">Last Name <span>(required)</span></label>
            <input id="last-name" type="text" required />
          </div>
        </div>

        <label for="email">Email <span>(required)</span></label>
        <input id="email" type="email" required />

        <label for="message">Message <span>(required)</span></label>
        <textarea id="message" required></textarea>

        <button type="submit">SEND</button>
      </form>
    </section>

    <section class="contact-right">
      <img src="/contact-billede.jpg" alt="People at Impact Festival" />
    </section>

    <section class="contact-bottom">
      <div class="bottom-left">
        <div class="bottom-socials">
          <a href="#">
            <img src="/instagram-logo.png" alt="Instagram" />
          </a>
          <a href="#" class="linkedin-bottom">in</a>
          <a href="#" class="facebook-bottom">f</a>
        </div>

        <img src="/impact-logo.png" alt="Impact Festival" class="bottom-impact-logo" />
      </div>

      <div class="bottom-right">
        <div class="contact-details">
          <div>
            <h2>Location</h2>
            <p>
              Bådehavnsgade 42<br />
              2450, København SV
            </p>
          </div>

          <div>
            <h2>Contact</h2>
            <p>
              <a href="mailto:impact@trifo.dk">impact@trifo.dk</a>
            </p>
          </div>
        </div>

        <p class="company-info">
          IMPACT FESTIVAL is organized by Forening Impact,<br />
          Sydhavnen, CVR no. 46334272, Bådehavnsgade 42, 2450<br />
          Copenhagen SV. Tickets are sold through
          <a href="#">billetsalg.dk</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    padding: 55px 65px;
    max-width: 1500px;
    margin: 0 auto;
  }

  .contact-left h1 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 82px;
    line-height: 0.78;
    margin: 0 0 25px;
    font-weight: 900;
    color: #000;
  }

  .contact-left p {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;
    line-height: 1.5;
    color: #000;
    max-width: 650px;
  }

  .contact-left a {
    color: #000;
    text-decoration: underline;
  }

  .intro {
    margin-bottom: 30px;
  }

  .contact-form {
    margin-top: 70px;
    max-width: 650px;
  }

  .contact-form label {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    margin-bottom: 7px;
    color: #000;
  }

  .contact-form label span {
    color: #555;
  }

  .name-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 22px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1.5px solid #000;
    border-radius: 24px;
    padding: 14px 18px;
    font-size: 16px;
    box-sizing: border-box;
    background: white;
  }

  .contact-form input {
    height: 48px;
  }

  .contact-form textarea {
    min-height: 160px;
    border-radius: 22px;
    resize: vertical;
    margin-bottom: 20px;
  }

  .contact-form > input {
    margin-bottom: 22px;
  }

  .contact-form button {
    background: #ed0b15;
    color: white;
    border: none;
    border-radius: 30px;
    padding: 14px 35px;
    font-size: 16px;
    cursor: pointer;
  }

  .contact-right img {
    width: 70%;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .contact-page {
      grid-template-columns: 1fr;
      padding: 30px 20px;
    }

    .contact-left h1 {
      font-size: 58px;
    }

    .name-row {
      grid-template-columns: 1fr;
    }

    .contact-right img {
      height: 500px;
    }
  }
  .contact-bottom {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 100px;

    max-width: 1500px;
    margin: 100px auto 0;
    padding: 0 65px 80px;

    box-sizing: border-box;
  }

  /* VENSTRE SIDE */

  .bottom-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bottom-socials {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-left: 260px;
  }

  .bottom-socials a {
    color: black;
    text-decoration: none;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 28px;
    font-weight: 700;
  }

  .bottom-socials img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  .bottom-impact-logo {
    width: 650px;
    max-width: 100%;
    height: auto;

    margin-top: 130px;
  }

  /* HØJRE SIDE */

  .bottom-right {
    padding-top: 110px;
  }

  .contact-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .contact-details h2 {
    margin: 0 0 35px;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 36px;
    font-weight: 900;

    color: black;
  }

  .contact-details p,
  .company-info {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;
    line-height: 1.5;

    color: black;
  }

  .contact-details a,
  .company-info a {
    color: black;
    text-decoration: underline;
  }

  .company-info {
    margin-top: 25px;
  }

  /* MOBIL */

  @media (max-width: 900px) {
    .contact-bottom {
      grid-template-columns: 1fr;
      gap: 50px;

      padding: 40px 20px;
    }

    .bottom-socials {
      margin-left: 0;
    }

    .bottom-impact-logo {
      width: 100%;
      margin-top: 60px;
    }

    .bottom-right {
      padding-top: 0;
    }

    .contact-details {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
