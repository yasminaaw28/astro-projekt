---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <main>
    <section class="hero">
      <div class="overlay"></div>

      <div class="hero-content">
        <img src="/forside-logo.png" alt="Impact Festival" class="hero-logo" />

        <div class="festival-info">
          <span>TRIFOLIUM</span>
          <span>11–12 SEP 2026</span>
        </div>

        <div class="festival-text">
          <p>MUSIC // ART // TALKS // WORKSHOPS // FOOD</p>
          <p>DESIGNED TO INCREASE OUR IMPACT</p>
        </div>
        <a href="/tickets" class="ticket-button">TICKETS</a>
      </div>
  
    </section>

    <section class="image-grid">
  <div class="image-card"><img src="/billede1.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede2.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede3.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede4.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede5.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede6.jpg" alt="" /></div>

  <div class="image-card"><img src="/billede7.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede8.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede9.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede10.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede11.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede12.jpg" alt="" /></div>

  <div class="image-card"><img src="/billede13.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede14.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede15.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede16.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede17.jpg" alt="" /></div>
  <div class="image-card"><img src="/billede18.jpg" alt="" /></div>
</section>
  </main>

</Layout>

<style>
 .hero {
  width: 100%;
  min-height: 850px;
  position: relative;

  background-image: url("/forside-billede.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

  .hero-content {
    width: 100%;
    position: relative;
    z-index: 2;
    padding: 80px 20px;
    box-sizing: border-box;
  }

  .hero-logo {
    width: 1100px;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .festival-info {
    width: 1100px;
    max-width: 72vw;
    margin: -40px auto 0;
    font-family: Arial, Helvetica, sans-serif;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 32px;
    font-weight: 700;
    color: white;
  }

  .festival-text {
    margin-top: 50px;
    text-align: center;
    font-family: Arial, Helvetica, sans-serif;
    color: white;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
  }

  .festival-text p {
    margin: 5px 0;
  }
  .ticket-button {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 210px;
  height: 67px;
  margin: 100px auto 0;

  background-color: #ed0b15;
  color: white;
  border: 2px solid white;
  border-radius: 50px;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 15px;
  font-weight: 400;
  text-decoration: none;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
  width: 90%;
  margin: 80px auto;
}

.image-card {
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
}

.image-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
  @media (max-width: 900px) {
    .hero {
      min-height: 650px;
    }

    .hero-logo {
      width: 100%;
    }

    .festival-info {
      max-width: 90vw;
      margin-top: -10px;
      font-size: 18px;
    }

    .festival-text {
      margin-top: 35px;
      font-size: 16px;
    }
    
 
</style>
